    "test:watch": "vitest",
    "update-prefix-map": "node scripts/update-prefix-map.mjs"
  },
  "dependencies": {
    "@astrojs/vue": "^7.1.6",
    "astro": "^7.4.12",
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.3.14"
  }
}
