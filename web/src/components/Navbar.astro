---
interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container">
    <a class="navbar-brand" href={base}>Babel Explorer</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class:list={['nav-link', { active: activePage === 'nodenorm' }]} href={`${base}nodenorm`}>
            NodeNorm
          </a>
        </li>
        <li class="nav-item">
          <a class:list={['nav-link', { active: activePage === 'nameres' }]} href={`${base}nameres`}>
            NameRes
          </a>
        </li>
        <li class="nav-item">
          <a class:list={['nav-link', { active: activePage === 'autocomplete' }]} href={`${base}autocomplete`}>
            Autocomplete
          </a>
        </li>
      </ul>
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href="https://github.com/TranslatorSRI/babel-explorer" target="_blank">GitHub</a>
        </li>
      </ul>
    </div>
  </div>
</nav>
