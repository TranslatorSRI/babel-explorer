---
import BaseLayout from '../layouts/BaseLayout.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<BaseLayout title="Babel Explorer" activePage="">
  <h2 class="mb-4">Babel Explorer Tools</h2>
  <p class="mb-4">
    Browser-based tools for exploring
    <a href="https://github.com/TranslatorSRI/Babel" target="_blank">Babel</a>
    cross-references,
    <a href="https://nodenormalization-sri.renci.org/docs" target="_blank">NodeNormalization</a>,
    and <a href="https://name-resolution-sri.renci.org/docs" target="_blank">NameRes</a>
    results.
  </p>

  <div class="row g-4">
    <div class="col-md-6 col-lg-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">NodeNorm</h5>
          <p class="card-text">
            Normalize CURIEs, inspect equivalent identifiers, compare results
            across NodeNorm deployments.
          </p>
          <a href={`${base}nodenorm`} class="btn btn-primary">Open NodeNorm</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">NameRes</h5>
          <p class="card-text">
            Look up biomedical concepts by name, compare results across
            NameRes deployments, validate expected CURIEs.
          </p>
          <a href={`${base}nameres`} class="btn btn-primary">Open NameRes</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Autocomplete</h5>
          <p class="card-text">
            Exercise NameRes as a live autocomplete. Tune parameters, compare
            environments side-by-side, and share query URLs for review.
          </p>
          <a href={`${base}autocomplete`} class="btn btn-primary">Open Autocomplete</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
